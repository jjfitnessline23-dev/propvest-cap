{
  "appId": "com.jjfitnessline.propvest",
  "appName": "Propvest",
  "webDir": "www",
  "server": {
    "url": "https://propvest-tau.vercel.app",
    "cleartext": false
  },
  "ios": {
    "contentInset": "automatic"
  },
  "appendUserAgent": "PropvestApp",
  "plugins": {
    "App": {
      "allowNavigation": [
        "propvest-tau.vercel.app",
        "*.vercel.app",
        "propvest.io",
        "*.propvest.io",
        "*.firebaseapp.com",
        "*.google.com",
        "*.gstatic.com",
        "js.stripe.com",
        "checkout.stripe.com"
      ]
    }
  }
}
